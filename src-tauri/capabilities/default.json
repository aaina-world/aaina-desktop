{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Files: only the app's own folders, Pictures/Aaina and Downloads, plus files and folders chosen in a file window or dropped on the window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "notification:default",
    "process:default",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-text",
    "window-state:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPCONFIG"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "$APPLOCALDATA"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$PICTURE/Aaina"
        },
        {
          "path": "$PICTURE/Aaina/**"
        },
        {
          "path": "$HOME/Pictures/Aaina"
        },
        {
          "path": "$HOME/Pictures/Aaina/**"
        },
        {
          "path": "$DOWNLOAD"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$HOME/Downloads"
        },
        {
          "path": "$HOME/Downloads/**"
        }
      ]
    },
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-rename",
    "fs:allow-stat",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://static.aaina.world/*"
        },
        {
          "url": "https://api.openai.com/*"
        },
        {
          "url": "https://auth.openai.com/*"
        },
        {
          "url": "https://chatgpt.com/*"
        },
        {
          "url": "https://api.github.com/*"
        }
      ]
    }
  ]
}
